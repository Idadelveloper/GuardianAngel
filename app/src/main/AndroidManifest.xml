<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="com.google.adk" />

    <!--
      Hands-free activation.

      RECORD_AUDIO is a while-in-use permission, so continuing to listen with the phone
      pocketed requires a foreground service typed "microphone". From Android 14 that
      type additionally requires FOREGROUND_SERVICE_MICROPHONE. The service can only be
      started while an activity is visible — Android has no exemption that would let
      Angel arm herself on boot.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Android 13+: needed to show the listening notification the service must display. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Location accompanies an alert so guardians know where to go. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- A microphone is not optional for this app, but the absence of one should fail at
         install time rather than halfway through a walk home. -->
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:name=".GuardianAngelApplication"
        android:allowBackup="false"
        android:fullBackupOnly="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        tools:replace="android:allowBackup"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GuardianAngel">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyPlaceholderGuardianAngelKey" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GuardianAngel"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.GuardianListeningService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>