<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="com.google.adk" />

    <!--
      Hands-free activation.

      RECORD_AUDIO is a while-in-use permission, so continuing to listen with the phone
      pocketed requires a foreground service typed "microphone". From Android 14 that
      type additionally requires FOREGROUND_SERVICE_MICROPHONE. The service can only be
      started while an activity is visible — Android has no exemption that would let
      Angel arm herself on boot.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Android 13+: needed to show the listening notification the service must display. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Location accompanies an alert so guardians know where to go. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
      Keeps the location stream alive while she is walking with the app in her pocket.
      Without it navigation stops the moment the screen goes off, silently.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
      Sends the guardian alert.

      A restricted permission on Google Play. The policy lists "Physical safety/emergency
      alerts to send SMS" as an eligible exception, which has to be declared through the
      Permissions Declaration Form in Play Console before release and is reviewed.

      The app works without it: SmsGuardianNotifier falls back to opening the messaging
      app with the alert pre-filled, which needs no permission but needs a tap. The UI
      says which of the two she has rather than implying a silent alert she will not get.
    -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!--
      Rings one guardian on the top alert tier, and only then. The number is one the user
      saved herself; nothing here dials an emergency service.

      Optional at runtime. Without it the call notification falls back to ACTION_DIAL,
      which opens the dialler with the number ready and needs no permission at all — a
      tap instead of a ring, which TelephonyGuardianCaller reports as a different
      outcome rather than passing off as a placed call.
    -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!--
      Puts the "Call <guardian>" button on the lock screen when an emergency alert fires
      with the phone in a pocket. Since Android 14 the system grants this automatically
      only to dialler and alarm apps, so the code asks canUseFullScreenIntent() and
      degrades to a heads-up banner rather than assuming it holds.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
      Not required. Declaring SEND_SMS otherwise implies a modem, which would stop the
      app installing on tablets and Chromebooks — devices a guardian might well use, and
      where everything except the silent-SMS path still works.
    -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!--
      Package visibility. Since Android 11 an app cannot see another app's presence
      without declaring it, and `getPackageInfo` throws NameNotFound regardless of
      whether WhatsApp is installed — so the fallback would silently never offer it.
    -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- A microphone is not optional for this app, but the absence of one should fail at
         install time rather than halfway through a walk home. -->
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:name=".GuardianAngelApplication"
        android:allowBackup="false"
        android:fullBackupOnly="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        tools:replace="android:allowBackup"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GuardianAngel">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GuardianAngel"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Navigation. Separate from the listening service because it needs no microphone
          and no models, so a walk survives standing the microphone down and a recording
          survives arriving. Android permits both foreground types at once.
        -->
        <service
            android:name=".service.GuardianNavigationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".service.GuardianListeningService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>